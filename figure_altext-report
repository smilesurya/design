def _collect_text(
    node,
    page_map,
    text_cache,
    inherited_page,
    parts,
):
    if isinstance(node, bool):
        return

    if isinstance(node, int):
        if inherited_page is not None:
            text = text_cache.get(
                inherited_page,
                node,
            )

            if text:
                parts.append(text)

        return

    if isinstance(node, pikepdf.Array):
        for child in node:
            _collect_text(
                child,
                page_map,
                text_cache,
                inherited_page,
                parts,
            )
        return

    if not isinstance(
        node,
        pikepdf.Dictionary,
    ):
        return

    if "/MCID" in node:
        page = get_struct_page_number(
            node,
            page_map,
            inherited_page,
        )

        try:
            mcid = int(node["/MCID"])
        except Exception:
            return

        if page is not None:
            text = text_cache.get(
                page,
                mcid,
                form="/Stm" in node,
            )

            if text:
                parts.append(text)

        return

    try:
        if "/ActualText" in node:
            actual = str(
                node["/ActualText"]
            ).strip()

            if actual:
                parts.append(actual)
                return

    except Exception:
        pass

    page = get_struct_page_number(
        node,
        page_map,
        inherited_page,
    )

    if "/K" in node:
        _collect_text(
            node["/K"],
            page_map,
            text_cache,
            page,
            parts,
        )


LIGATURES = {
    "\ufb00": "ff",
    "\ufb01": "fi",
    "\ufb02": "fl",
    "\ufb03": "ffi",
    "\ufb04": "ffl",
    "\ufb05": "st",
    "\ufb06": "st",
}


def clean_text(text):
    text = re.sub(
        r"[\x00-\x08\x0b\x0c"
        r"\x0e-\x1f\x7f]",
        "",
        text,
    )

    text = re.sub(
        r"[\u00ad\u200b\u200c"
        r"\u200d\u2060\ufeff]",
        "",
        text,
    )

    for ligature, letters in (
        LIGATURES.items()
    ):
        text = text.replace(
            ligature,
            letters,
        )

    return re.sub(
        r"\s+",
        " ",
        text,
    ).strip()


def get_element_text(
    elem,
    page_map,
    text_cache,
    inherited_page,
):
    parts = []

    _collect_text(
        elem,
        page_map,
        text_cache,
        inherited_page,
        parts,
    )

    return clean_text(
        " ".join(parts)
    )


def _collect_text_candidates(
    node,
    page_map,
    text_cache,
    inherited_page,
    out,
):
    if isinstance(node, bool):
        return

    if isinstance(node, int):
        if inherited_page is not None:

            for value in (
                text_cache.get_candidates(
                    inherited_page,
                    node,
                )
            ):
                if (
                    value
                    and value not in out
                ):
                    out.append(value)

        return

    if isinstance(node, pikepdf.Array):
        for child in node:
            _collect_text_candidates(
                child,
                page_map,
                text_cache,
                inherited_page,
                out,
            )

        return

    if not isinstance(
        node,
        pikepdf.Dictionary,
    ):
        return

    try:
        if "/ActualText" in node:
            value = clean_text(
                str(node["/ActualText"])
            )

            if (
                value
                and value not in out
            ):
                out.append(value)

    except Exception:
        pass

    if "/MCID" in node:
        page = get_struct_page_number(
            node,
            page_map,
            inherited_page,
        )

        try:
            mcid = int(node["/MCID"])
        except Exception:
            mcid = None

        if (
            page is not None
            and mcid is not None
        ):
            for value in (
                text_cache.get_candidates(
                    page,
                    mcid,
                    form="/Stm" in node,
                )
            ):
                if (
                    value
                    and value not in out
                ):
                    out.append(value)

        return

    page = get_struct_page_number(
        node,
        page_map,
        inherited_page,
    )

    try:
        if "/K" in node:
            _collect_text_candidates(
                node["/K"],
                page_map,
                text_cache,
                page,
                out,
            )
    except Exception:
        pass


def get_element_text_candidates(
    elem,
    page_map,
    text_cache,
    inherited_page,
):
    values = []

    _collect_text_candidates(
        elem,
        page_map,
        text_cache,
        inherited_page,
        values,
    )

    combined = get_element_text(
        elem,
        page_map,
        text_cache,
        inherited_page,
    )

    if (
        combined
        and combined not in values
    ):
        values.append(combined)

    return values


