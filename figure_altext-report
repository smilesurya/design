def normalise_label(label):
    match = re.match(
        r"(?i)"
        r"(f\s?i\s?g\s?u\s?r\s?e|"
        r"f\s?i\s?g)"
        r"(.*)$",
        label,
    )

    if not match:
        return label

    letters = re.sub(
        r"\s",
        "",
        match.group(1),
    ).lower()

    word = (
        "Figure"
        if letters == "figure"
        else "Fig"
    )

    return word + match.group(2)


def describe_following(
    nodes,
    figure_index,
    page_map,
    text_cache,
    limit=3,
):
    depth = nodes[
        figure_index
    ]["depth"]

    j = figure_index + 1

    while (
        j < len(nodes)
        and nodes[j]["depth"] > depth
    ):
        j += 1

    shown = []

    while (
        j < len(nodes)
        and len(shown) < limit
    ):
        node = nodes[j]
        j += 1

        if (
            node["tag"]
            in CONTAINER_TAGS
        ):
            continue

        text = ""

        if node["tag"] in (
            "P",
            "Caption",
            "H1",
            "H2",
            "H3",
            "H4",
            "Lbl",
        ):
            text = get_element_text(
                node["elem"],
                page_map,
                text_cache,
                node["page"],
            )

        text = (
            text[:40]
            + (
                "..."
                if len(text) > 40
                else ""
            )
        )

        shown.append(
            (
                f'<{node["tag"]}> '
                f'"{text}"'
            )
            if text
            else f'<{node["tag"]}>'
        )

    return (
        ", ".join(shown)
        if shown
        else "nothing"
    )


def _match_caption_text(text):
    text = clean_text(
        text or ""
    )

    text = LEADING_JUNK_REGEX.sub(
        "",
        text,
    )

    if not text:
        return None, None

    match = CAPTION_LABEL_REGEX.match(
        text
    )

    if not match:
        return None, None

    figure_no = normalise_label(
        re.sub(
            r"\s+",
            " ",
            match.group(1),
        ).strip()
    )

    caption = (
        figure_no
        + text[match.end(1):]
    )

    return caption, figure_no


def _match_figure_no_text(text):
    text = clean_text(
        text or ""
    )

    if not text:
        return None

    _, figure_no = (
        _match_caption_text(text)
    )

    if figure_no:
        return figure_no

    match = (
        FIGURE_NO_ANYWHERE_REGEX.search(
            text
        )
    )

    if not match:
        return None

    label = re.sub(
        r"\s+",
        " ",
        match.group(1),
    ).strip()

    return normalise_label(label)


def find_caption_sibling(
    nodes,
    figure_index,
    page_map,
    text_cache,
):
    figure_depth = nodes[
        figure_index
    ]["depth"]

    j = figure_index + 1

    while (
        j < len(nodes)
        and nodes[j]["depth"]
        > figure_depth
    ):
        j += 1

    while (
        j < len(nodes)
        and nodes[j]["tag"]
        in CONTAINER_TAGS
    ):
        j += 1

    if j >= len(nodes):
        return (
            None,
            None,
            "no tag follows the <Figure>",
        )

    candidate = nodes[j]

    if candidate["tag"] not in (
        CAPTION_TAGS
    ):
        return (
            None,
            None,
            (
                "next tag after <Figure> is "
                f"<{candidate['tag']}>, "
                "not one of "
                f"{sorted(CAPTION_TAGS)}"
            ),
        )

    page_hint = (
        candidate["page"]
        or nodes[
            figure_index
        ]["page"]
    )

    text = get_element_text(
        candidate["elem"],
        page_map,
        text_cache,
        page_hint,
    )

    raw_text = (
        LEADING_JUNK_REGEX.sub(
            "",
            clean_text(
                text or ""
            ),
        )
    )

    if not raw_text:
        return (
            None,
            None,
            (
                f"the <{candidate['tag']}> "
                "after <Figure> has no "
                "readable text "
                f"(PDF page {page_hint})"
            ),
        )

    caption, figure_no = (
        _match_caption_text(
            raw_text
        )
    )

    if not caption:
        snippet = (
            raw_text
            if len(raw_text) <= 60
            else (
                raw_text[:57]
                + "..."
            )
        )

        return (
            None,
            None,
            (
                f"the <{candidate['tag']}> "
                "after <Figure> does not "
                "start with 'Figure N' / "
                f"'Fig. N' (\"{snippet}\")"
            ),
        )

    return (
        caption,
        figure_no,
        None,
    )


def find_caption_in_figure(
    nodes,
    figure_index,
    page_map,
    text_cache,
):
    figure_depth = nodes[
        figure_index
    ]["depth"]

    figure_page = nodes[
        figure_index
    ]["page"]

    j = figure_index + 1

    checked_any = False

    while (
        j < len(nodes)
        and nodes[j]["depth"]
        > figure_depth
    ):
        node = nodes[j]

        if node["tag"] in (
            CAPTION_TAGS
        ):
            checked_any = True

            page_hint = (
                node["page"]
                or figure_page
            )

            text = get_element_text(
                node["elem"],
                page_map,
                text_cache,
                page_hint,
            )

            caption, figure_no = (
                _match_caption_text(text)
            )

            if caption:
                return (
                    caption,
                    figure_no,
                    None,
                )

        j += 1

    if not checked_any:
        return (
            None,
            None,
            (
                "no <P>/<Caption> tag "
                "found nested inside "
                "the <Figure>"
            ),
        )

    return (
        None,
        None,
        (
            "found <P>/<Caption> tag(s) "
            "nested inside the <Figure>, "
            "but none of their merged "
            "text starts with "
            "'Figure N' / 'Fig. N'"
        ),
    )


def find_figure_no_in_figure(
    nodes,
    figure_index,
    page_map,
    text_cache,
):
    """
    UPDATED PRIORITY

    1. <Figure> -> <P>/<Caption> -> descendant <Span>
    2. nested <P>/<Caption> text
    3. any <Span> in current Figure
    4. full Figure subtree

    This function returns ONLY the Figure No.
    """

    figure_depth = nodes[
        figure_index
    ]["depth"]

    figure_page = nodes[
        figure_index
    ]["page"]

    subtree_end = (
        figure_index + 1
    )

    while (
        subtree_end < len(nodes)
        and nodes[
            subtree_end
        ]["depth"] > figure_depth
    ):
        subtree_end += 1

    def number_from_node(
        node,
        fallback_page=None,
    ):
        page_hint = (
            node["page"]
            or fallback_page
            or figure_page
        )

        for candidate_text in (
            get_element_text_candidates(
                node["elem"],
                page_map,
                text_cache,
                page_hint,
            )
        ):
            figure_no = (
                _match_figure_no_text(
                    candidate_text
                )
            )

            if figure_no:
                return figure_no

        return None

    # --------------------------------------------------------
    # PASS 1
    # Exact required hierarchy:
    # <Figure> -> <P>/<Caption> -> ... -> <Span>
    # --------------------------------------------------------

    j = figure_index + 1

    while j < subtree_end:
        parent = nodes[j]

        if parent["tag"] in (
            CAPTION_TAGS
        ):
            parent_depth = (
                parent["depth"]
            )

            k = j + 1

            while (
                k < subtree_end
                and nodes[k]["depth"]
                > parent_depth
            ):
                child = nodes[k]

                if child["tag"] == "Span":

                    figure_no = (
                        number_from_node(
                            child,
                            parent["page"]
                            or figure_page,
                        )
                    )

                    if figure_no:
                        return (
                            figure_no,
                            None,
                        )

                k += 1

        j += 1

    # --------------------------------------------------------
    # PASS 2
    # Nested P/Caption text fallback.
    # --------------------------------------------------------

    for j in range(
        figure_index + 1,
        subtree_end,
    ):
        node = nodes[j]

        if node["tag"] not in (
            CAPTION_TAGS
        ):
            continue

        figure_no = number_from_node(
            node,
            figure_page,
        )

        if figure_no:
            return (
                figure_no,
                None,
            )

    # --------------------------------------------------------
    # PASS 3
    # Any Span inside Figure subtree.
    # --------------------------------------------------------

    for j in range(
        figure_index + 1,
        subtree_end,
    ):
        node = nodes[j]

        if node["tag"] != "Span":
            continue

        figure_no = number_from_node(
            node,
            figure_page,
        )

        if figure_no:
            return (
                figure_no,
                None,
            )

    # --------------------------------------------------------
    # PASS 4
    # Complete Figure subtree.
    # --------------------------------------------------------

    figure_node = nodes[
        figure_index
    ]

    figure_no = number_from_node(
        figure_node,
        figure_page,
    )

    if figure_no:
        return (
            figure_no,
            None,
        )

    return (
        None,
        (
            "no Figure/Fig. number "
            "could be read from "
            "<Figure> -> "
            "<P>/<Caption> -> <Span>"
        ),
    )


def find_caption(
    nodes,
    figure_index,
    page_map,
    text_cache,
):
    """
    UPDATED BEHAVIOUR

    Figure No. is extracted independently FIRST.

    Figure No. priority:
      1. <Figure> -> <P>/<Caption> -> <Span>
      2. Existing fallbacks inside the Figure
      3. Caption-derived number only if nested Figure number
         could not be found

    Caption priority remains unchanged:
      1. sibling <P>/<Caption>
      2. nested <P>/<Caption>
    """

    # --------------------------------------------------------
    # STEP 1
    # Read Figure No. from the Figure subtree FIRST.
    # --------------------------------------------------------

    nested_figure_no, reason_number = (
        find_figure_no_in_figure(
            nodes,
            figure_index,
            page_map,
            text_cache,
        )
    )

    # --------------------------------------------------------
    # STEP 2
    # Existing sibling caption behaviour.
    # --------------------------------------------------------

    (
        sibling_caption,
        sibling_caption_no,
        reason_sibling,
    ) = find_caption_sibling(
        nodes,
        figure_index,
        page_map,
        text_cache,
    )

    if sibling_caption:
        figure_no = (
            nested_figure_no
            or sibling_caption_no
        )

        return (
            sibling_caption,
            figure_no,
            None,
        )

    # --------------------------------------------------------
    # STEP 3
    # Existing nested caption behaviour.
    # --------------------------------------------------------

    (
        nested_caption,
        nested_caption_no,
        reason_nested,
    ) = find_caption_in_figure(
        nodes,
        figure_index,
        page_map,
        text_cache,
    )

    if nested_caption:
        figure_no = (
            nested_figure_no
            or nested_caption_no
        )

        return (
            nested_caption,
            figure_no,
            None,
        )

    # --------------------------------------------------------
    # STEP 4
    # No caption, but Figure No. exists.
    # --------------------------------------------------------

    if nested_figure_no:
        return (
            None,
            nested_figure_no,
            (
                f"{reason_sibling}; "
                f"{reason_nested}"
            ),
        )

    # --------------------------------------------------------
    # STEP 5
    # Nothing found.
    # --------------------------------------------------------

    return (
        None,
        None,
        (
            f"{reason_sibling}; "
            f"{reason_nested}; "
            f"{reason_number}"
        ),
    )


