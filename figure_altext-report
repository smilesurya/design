def get_struct_page_number(
    struct_elem,
    page_map,
    inherited_page=None,
):
    current_page = inherited_page

    try:
        if "/Pg" in struct_elem:
            pg = struct_elem["/Pg"]

            try:
                objgen = pg.objgen

                if objgen in page_map:
                    current_page = page_map[objgen]

            except Exception:
                pass

    except Exception:
        pass

    return current_page


